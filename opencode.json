{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local vLLM Provider",
      "options": {
        "baseURL": "http://localhost:8000/v1"
      },
      "models": {
        "unsloth/Qwen3.8-27B-NVFP4": {
          "name": "Qwen 3.8 27B NVFP4",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gittensor-model-hub/Qwen3.8-27B-NVFP4-RTX5090": {
          "name": "Qwen 3.8 27B NVFP4 (gittensor, modelopt)",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
